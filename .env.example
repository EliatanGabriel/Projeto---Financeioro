# NoAzul — variáveis do Supabase (copie para .env.local e preencha com os valores DO SEU projeto)
# Nunca invente valores: eles vêm de Supabase Dashboard → Project Settings → API.
# Sem essas variáveis o app continua funcionando em modo local/offline (sem contas nem nuvem).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_COLE_SUA_CHAVE_ANON_AQUI

# NUNCA coloque SUPABASE_SERVICE_ROLE_KEY ou qualquer credencial administrativa no frontend,
# em variáveis VITE_* ou no repositório. Ela só é usada no servidor (Edge Function futura de exclusão de conta).
